# ==============================================================================
# Serenity AI Companion — Environment Configuration
# Copy this file to '.env' and fill in your Gemini API key
# ==============================================================================

# Required: Google Gemini API Key
# Obtain free from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Express Server Port (Default: 3001)
PORT=3001

# Optional: Frontend client direct key (fallback only, backend /api/config is used by default)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
